rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is staff (admin/trainer)
    function isStaff() {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return role == 'admin' || role == 'trainer';
    }

    // Helper function to check if exactly admin
    function isAdmin() {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return role == 'admin';
    }

    match /users/{userId} {
      // Helper para verificar si es el dueño
      function isOwner() {
        return request.auth.uid == userId;
      }

      // Solo el dueño o un miembro del staff puede leer perfiles
      allow read: if request.auth != null && (isOwner() || isStaff());
      
      // Creación blindada: 
      // 1. Debe ser el dueño (uid coincidente)
      // 2. EL ROL INICIAL DEBE SER 'trainee' (SEGURIDAD CRÍTICA)
      allow create: if request.auth != null && isOwner() && request.resource.data.role == 'trainee';

      // Para actualizar: 
      // 1. Admins tienen control total.
      // 2. El dueño puede editar todo EXCEPTO su rol y su entrenador asignado.
      // 3. El Entrenador ASIGNADO puede editar el perfil (ej. para asignar rutinas).
      allow update: if request.auth != null && (
        isAdmin() || 
        (
          isOwner() && 
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'trainerId', 'trainerName']))
        ) ||
        (
          isStaff() && 
          resource.data.trainerId == request.auth.uid
        )
      );

      // Solo Admins pueden borrar perfiles (Protección de Integridad)
      allow delete: if request.auth != null && isAdmin();
    }

    match /gym_configs/{docId} {
      // Todos pueden leer la configuración del gimnasio (para ver noticias e info)
      allow read: if true;
      // Solo el staff puede modificar la configuración o añadir noticias
      allow write: if request.auth != null && isStaff();
    }

    match /invoices/{invoiceId} {
      // Solo staff puede ver todas las facturas. Usuarios pueden ver las suyas.
      allow read: if request.auth != null && (isStaff() || resource.data.userId == request.auth.uid);
      // Solo staff puede crear facturas
      allow write: if request.auth != null && isStaff();
    }
  }
}
