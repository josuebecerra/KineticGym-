rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is staff (admin/trainer)
    function isStaff() {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return role == 'admin' || role == 'trainer';
    }

    // Helper function to check if exactly admin
    function isAdmin() {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return role == 'admin';
    }

    match /users/{userId} {
      // Solo el dueño o un miembro del staff puede leer perfiles
      allow read: if request.auth != null && (request.auth.uid == userId || isStaff());
      
      // Creación libre para el usuario mismo (usualmente al loguearse la primera vez no hay recurso aún)
      allow create: if request.auth != null && request.auth.uid == userId;

      // Para actualizar: si se intenta modificar "role", debe ser admin.
      // De lo contrario, solo requiere ser el dueño de la cuenta o parte del staff.
      allow update: if request.auth != null && (
        isAdmin() || 
        (
          (request.auth.uid == userId || isStaff()) && 
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        )
      );
    }
  }
}
